{
  "name": "polis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mobile"
  ],
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:web && npm run build:mobile",
    "build:web": "next build",
    "build:mobile": "npm run build --workspace @polis/mobile",
    "start": "next start",
    "lint": "eslint && npm run check --workspace @polis/mobile",
    "test": "vitest run && npm run test --workspace @polis/mobile",
    "eval:golden": "vitest run --config vitest.eval.config.ts",
    "eval:coverage": "node evals/run-coverage.mjs",
    "mobile:sync": "npm run sync:ios --workspace @polis/mobile",
    "mobile:open": "npm run open:ios --workspace @polis/mobile",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "2.99.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
